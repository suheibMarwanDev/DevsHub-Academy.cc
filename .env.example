# Marketing/demo mode keeps the visible Admin + Verifier experience open.
# Set to false only when real admin authentication is implemented.
DEMO_MODE=true

# Optional hardening switch for API writes when DEMO_MODE=false.
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Cloud certificate storage (Upstash Redis / compatible Vercel KV REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compatible aliases also supported by the API:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

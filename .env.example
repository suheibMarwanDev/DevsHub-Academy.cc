# Marketing/demo mode keeps the visible Admin + Verifier experience open.
# Authentication will be added in the next project phase.
DEMO_MODE=true

# Optional hardening switch for API writes when DEMO_MODE=false.
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Preferred production database: Supabase PostgreSQL.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side only. Never expose it in frontend JS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_ORGANIZATION_SLUG=devshub-academy

# Legacy/fallback cloud storage. Used only when Supabase is not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compatible Redis aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

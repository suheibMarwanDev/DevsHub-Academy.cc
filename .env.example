# Marketing/demo mode keeps the visible Admin + Verifier experience open.
# true  = Admin remains open for customer demonstrations.
# false = Admin requires a real Supabase Auth session.
DEMO_MODE=true

# Preferred production database + authentication provider: Supabase.
# All keys below are server-side environment variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_ORGANIZATION_SLUG=devshub-academy

# IMPORTANT:
# Never place SUPABASE_SERVICE_ROLE_KEY in index.html or assets/app.js.

# Legacy/fallback cloud storage. Used only when Supabase PostgreSQL is not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compatible Redis aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
